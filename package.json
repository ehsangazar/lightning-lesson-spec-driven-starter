{
  "name": "spec-driven-starter",
  "version": "1.0.0",
  "private": true,
  "description": "The spec-kit walkthrough, built from scratch: constitution, spec, plan, tasks, then code.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gate": "node scripts/gate.mjs",
    "start": "node --experimental-strip-types src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
