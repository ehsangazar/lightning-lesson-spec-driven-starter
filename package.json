{
  "name": "spec-driven-starter",
  "version": "1.0.0",
  "private": true,
  "description": "A template for getting mergeable code out of a coding agent: an executable spec, a constraints file, and a gate that blocks a plausible diff.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "gate": "node scripts/gate.mjs",
    "new-spec": "node scripts/new-spec.mjs",
    "demo:reset": "node scripts/demo-reset.mjs",
    "start": "node --experimental-strip-types src/server.ts"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
